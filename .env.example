# Copy to .env and adjust as needed.

# Image tag to build/run. In CI this is set to the 7-character short
# commit hash; locally it defaults to "dev".
VERSION=dev

# Host port that nginx (the site's single entrypoint) is published on.
HTTP_PORT=8080

# Steam Web API key (steamcommunity.com/dev/apikey). Only the daily game
# catalog refresh (IStoreService/GetAppList) needs this -- item/collection
# resolution itself is key-free and works without it. Never commit a real
# value here.
STEAM_API_KEY=

# SteamID64 of the account the key above belongs to. Not read by any code
# yet -- reserved for the later SteamCMD download phase, which needs an
# account to log in as (anonymous login also works for most Workshop
# content, this is only for whatever doesn't allow that).
STEAM_ACCOUNT_ID=
