{
  "name": "steamworkshop-downloader",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:admin": "vite --config vite.admin.config.ts",
    "build:admin": "tsc -b && vite build --config vite.admin.config.ts",
    "dev:all": "concurrently -n public,admin -c blue,green \"npm run dev\" \"npm run dev:admin\""
  },
  "dependencies": {
    "preact": "^10.29.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
